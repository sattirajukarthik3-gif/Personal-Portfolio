---
import { profile } from "../data/resume";
const year = new Date().getFullYear();

const { version, commitHash, commitDate } = __BUILD_INFO__;
const formattedDate = commitDate
  ? new Date(commitDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
const commitUrl = commitHash
  ? `https://github.com/sattirajukarthik3-gif/Personal-Portfolio/commit/${commitHash}`
  : null;
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:justify-between dark:text-zinc-500">
    <p>&copy; {year} {profile.name}. Built from scratch.</p>
    <div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-4">
      <a href={`mailto:${profile.email}`} class="hover:text-accent-600 dark:hover:text-accent-400">
        Email
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400">
        LinkedIn
      </a>
      <span
        class="text-xs text-zinc-400 dark:text-zinc-600"
        title={commitHash ? `Commit ${commitHash}` : undefined}
      >
        v{version}
        {formattedDate && ` · ${formattedDate}`}
        {commitHash && commitUrl && (
          <>
            {" · "}
            <a
              href={commitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent-600 dark:hover:text-accent-400"
            >
              {commitHash}
            </a>
          </>
        )}
      </span>
    </div>
  </div>
</footer>
