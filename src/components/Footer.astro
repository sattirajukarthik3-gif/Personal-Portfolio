---
import { profile } from "../data/resume";
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:justify-between dark:text-zinc-500">
    <p>&copy; {year} {profile.name}. Built from scratch.</p>
    <div class="flex items-center gap-4">
      <a href={`mailto:${profile.email}`} class="hover:text-accent-600 dark:hover:text-accent-400">
        Email
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400">
        LinkedIn
      </a>
    </div>
  </div>
</footer>
