---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/resume";
---

<Layout title="Contact" description="Get in touch with Karthik Sattiraju.">
  <section class="fade-in-section mx-auto max-w-2xl px-6 pt-20 pb-24 text-center">
    <p class="font-display text-sm font-medium uppercase tracking-widest text-accent-600 dark:text-accent-400">
      Contact
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Let's talk.
    </h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
      Open to Associate Project Manager and Product Manager roles. The
      fastest way to reach me is email.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center">
      <button
        id="copy-email"
        data-email={profile.email}
        class="rounded-full bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-105 dark:bg-white dark:text-zinc-900"
      >
        <span id="copy-email-label">Copy Email &middot; {profile.email}</span>
      </button>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-900 transition-transform hover:scale-105 dark:border-zinc-700 dark:text-white"
      >
        Connect on LinkedIn
      </a>
    </div>

    <p class="mt-8 text-sm text-zinc-500">{profile.location}</p>
  </section>
</Layout>

<script>
  import "../scripts/animations";

  function setupCopyEmail() {
    const button = document.getElementById("copy-email");
    const label = document.getElementById("copy-email-label");
    if (!button || !label) return;

    // ClientRouter can re-run this script; only bind each button once.
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const email = button.dataset.email ?? "";
    const originalText = label.textContent;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = "Copied to clipboard!";
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          label.textContent = originalText;
        }, 2000);
      } catch {
        // Clipboard API needs a focused document + secure context; fall back
        // to opening the user's mail client instead of failing silently.
        window.location.href = `mailto:${email}`;
      }
    });
  }

  if (!window.__contactBound) {
    window.__contactBound = true;
    document.addEventListener("astro:page-load", setupCopyEmail);
  }
</script>
