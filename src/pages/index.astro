---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/resume";

const allProjects = await getCollection("projects");
const featured = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const stats = [
  { value: 95, suffix: "%", label: "Manual inventory workload cut on a computer vision rollout" },
  { value: 3, suffix: "s", prefix: "<", label: "Equipment retrieval time, down from manual search" },
  { value: 25, suffix: "%", label: "Forecasting accuracy improvement from automated dashboards" },
];
---

<Layout title="Home">
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
    <p class="hero-line font-display text-sm font-medium uppercase tracking-widest text-accent-600 dark:text-accent-400">
      {profile.role} · {profile.location}
    </p>
    <h1 class="hero-line mt-4 font-display text-4xl font-bold tracking-tight sm:text-6xl">
      Hi, I'm {profile.name}.
    </h1>
    <p class="hero-line mt-6 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
      {profile.summary}
    </p>
    <div class="hero-line mt-8 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="rounded-full bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-105 dark:bg-white dark:text-zinc-900"
      >
        View Projects
      </a>
      <a
        href="/contact"
        class="rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-900 transition-transform hover:scale-105 dark:border-zinc-700 dark:text-white"
      >
        Get in Touch
      </a>
    </div>
  </section>

  <section class="fade-in-section mx-auto max-w-5xl border-t border-zinc-200 px-6 py-16 dark:border-zinc-800">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <div>
            <p class="font-display text-4xl font-bold text-accent-600 dark:text-accent-400">
              {stat.prefix}
              <span class="stat-number" data-target={stat.value}>0</span>
              {stat.suffix}
            </p>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="fade-in-section mx-auto max-w-5xl px-6 py-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Featured work</h2>
      <a href="/projects" class="text-sm font-medium text-accent-600 hover:underline dark:text-accent-400">
        View all &rarr;
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        featured.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="project-card group block rounded-2xl border border-zinc-200 p-6 transition-colors hover:border-accent-400 dark:border-zinc-800 dark:hover:border-accent-600"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">
              {project.data.category}
            </p>
            <h3 class="mt-2 font-display text-lg font-semibold group-hover:text-accent-600 dark:group-hover:text-accent-400">
              {project.data.title}
            </h3>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{project.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="fade-in-section mx-auto max-w-5xl px-6 py-16">
    <div class="rounded-3xl bg-zinc-900 px-8 py-12 text-center dark:bg-zinc-900">
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
        Let's build something worth shipping.
      </h2>
      <p class="mt-3 text-zinc-400">
        Open to Associate Project Manager and Product Manager roles.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-900 transition-transform hover:scale-105"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>

<script>
  import "../scripts/animations";
</script>
