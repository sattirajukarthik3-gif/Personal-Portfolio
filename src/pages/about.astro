---
import Layout from "../layouts/Layout.astro";
import { profile, skillGroups, experience, education } from "../data/resume";
---

<Layout title="About" description={profile.summary}>
  <section class="fade-in-section mx-auto max-w-3xl px-6 pt-20 pb-12">
    <p class="font-display text-sm font-medium uppercase tracking-widest text-accent-600 dark:text-accent-400">
      About
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {profile.role} building AI-enabled software, one delivery at a time.
    </h1>
    <p class="mt-6 text-lg text-zinc-600 dark:text-zinc-400">{profile.summary}</p>
  </section>

  <section class="fade-in-section mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-bold">Experience</h2>
    <div class="mt-8 flex flex-col gap-10">
      {
        experience.map((role) => (
          <div class="relative border-l-2 border-zinc-200 pl-6 dark:border-zinc-800">
            <div class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-accent-500" />
            <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">{role.dates}</p>
            <h3 class="mt-1 font-display text-lg font-semibold">{role.title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              {role.company} &middot; {role.location}
            </p>
            <ul class="mt-3 flex flex-col gap-2 text-sm text-zinc-700 dark:text-zinc-300">
              {role.bullets.map((bullet) => (
                <li class="flex gap-2">
                  <span class="text-accent-500">&bull;</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="fade-in-section mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-bold">Skills</h2>
    <div class="mt-8 flex flex-col gap-6">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">{group.label}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="fade-in-section mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-bold">Education</h2>
    <div class="mt-6">
      <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">{education.dates}</p>
      <h3 class="mt-1 font-display text-lg font-semibold">{education.degree}</h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">{education.school}</p>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{education.details}</p>
      <ul class="mt-3 flex flex-col gap-1 text-sm text-zinc-700 dark:text-zinc-300">
        {education.certifications.map((cert) => (
          <li class="flex gap-2">
            <span class="text-accent-500">&bull;</span>
            <span>{cert}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  import "../scripts/animations";
</script>
