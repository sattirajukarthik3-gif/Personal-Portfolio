---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Projects" description="Case studies from enterprise software delivery across healthcare, retail, and insurance.">
  <section class="fade-in-section mx-auto max-w-5xl px-6 pt-20 pb-8">
    <p class="font-display text-sm font-medium uppercase tracking-widest text-accent-600 dark:text-accent-400">
      Projects
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Case studies from the field.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
      Enterprise deliveries across healthcare, retail, and insurance — plus
      where it started, building internal tools as a developer.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        allProjects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="project-card group flex flex-col rounded-2xl border border-zinc-200 p-6 transition-colors hover:border-accent-400 dark:border-zinc-800 dark:hover:border-accent-600"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">
              {project.data.category}
            </p>
            <h2 class="mt-2 font-display text-xl font-semibold group-hover:text-accent-600 dark:group-hover:text-accent-400">
              {project.data.title}
            </h2>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{project.data.summary}</p>
            <p class="mt-4 text-xs text-zinc-500">
              {project.data.company} &middot; {project.data.dates}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import "../../scripts/animations";
</script>
